        <mxCell id="label11" parent="1" style="text;html=0;strokeColor=none;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;whiteSpace=wrap;spacing=2;align=left;fontSize=13;fontStyle=0;" value="One user may own many listings and submit many requests. One category may contain many listings.&#xa;Each request has one target listing. Donation: offered_listing_id must be NULL.&#xa;Exchange: offered_listing_id must identify a requester-owned listing different from target_listing_id." vertex="1">
          <mxGeometry height="54" width="1410" x="70" y="1323" as="geometry" />
        </mxCell>
        <mxCell id="label12" parent="1" style="text;html=0;strokeColor=none;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;whiteSpace=wrap;spacing=2;align=left;fontSize=13;fontStyle=0;" value="Translation rows reference EITHER a listing OR a request, never both. One cache row per parent, field and target language.&#xa;source_hash checks the current source text and language. Supported languages: English and Bahasa Melayu." vertex="1">
          <mxGeometry height="54" width="1410" x="70" y="1385" as="geometry" />
        </mxCell>
        <mxCell id="label13" parent="1" style="text;html=0;strokeColor=none;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;verticalAlign=middle;whiteSpace=wrap;spacing=2;align=left;fontSize=13;fontStyle=0;" value="Keep completed history. Archive listings instead of deleting referenced records. Pickup confirmation uses two timestamp fields.&#xa;USER_SESSIONS keeps login sessions available to both web servers. No payment, chat or delivery tables are required." vertex="1">
          <mxGeometry height="54" width="1410" x="70" y="1448" as="geometry" />
        </mxCell>
